{
  "name": "haul-hours",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx scripts/backend.ts dev",
    "dev:demo": "concurrently --kill-others -n api,web \"npm:dev:api:demo\" \"npm:dev:web\"",
    "dev:api:demo": "tsx scripts/backend.ts demo",
    "dev:web": "npm run dev -w @haul-hours/web",
    "test:api": "tsx scripts/backend.ts test",
    "test:web": "npm run test -w @haul-hours/web -- --run",
    "test": "npm run test:api && npm run test:web",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck -w @haul-hours/web",
    "build": "npm run build -w @haul-hours/web",
    "check:api": "tsx scripts/backend.ts check",
    "lint": "tsx scripts/backend.ts lint && npm run typecheck",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:check": "tsx scripts/generate-contracts.ts --check",
    "test:e2e": "npm run test:e2e -w @haul-hours/web --"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
