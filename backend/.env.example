DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-stable-random-secret-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ORS_API_KEY=
# Gateway root; custom/legacy API roots retain /v2 and /geocode paths.
ORS_BASE_URL=https://api.heigit.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional compatible backups, tried once each after timeouts/invalid responses.
# Use provider endpoints whose usage policies permit your deployment.
OVERPASS_FALLBACK_URLS=
# Set true on production hosts other than Vercel (Vercel is detected automatically).
HAUL_HOURS_PRODUCTION=false
# Enable only behind a trusted proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
PROVIDER_MODE=live
STOP_PROVIDER=dot
# Rest: USDOT/BTS truck-parking inventory. Fuel: ORS POIs plus original OSM access tags.
# STOP_PROVIDER=overpass selects a compatible private/public Overpass provider instead.
# Conservative process-local spacing; tune to your account's current quotas.
ORS_MIN_INTERVAL_S=2
OVERPASS_MIN_INTERVAL_S=2
