DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-stable-random-secret-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ORS_API_KEY=
# Gateway root; custom/legacy API roots retain /v2 and /geocode paths.
ORS_BASE_URL=https://api.heigit.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
PROVIDER_MODE=live
# Conservative process-local spacing; tune to your account's current quotas.
ORS_MIN_INTERVAL_S=2
OVERPASS_MIN_INTERVAL_S=2
