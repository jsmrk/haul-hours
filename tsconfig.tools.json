{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "allowJs": false, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
